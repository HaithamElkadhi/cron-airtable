# --- Airtable API ---
# Base: set AIRTABLE_BASE_ID or paste a URL that contains appXXXXXXXXXXXXXX
AIRTABLE_BASE_URL=https://airtable.com/appXXXXXXXXXXXXXX/
# AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Personal Access Token: https://airtable.com/create/tokens
# Scopes: data.records:read always; add data.records:write if you update KPIS
AIRTABLE_PERSONAL_ACCESS_TOKEN=patXXXXXXXXXXXXXXXX

# Legacy name also supported: AIRTABLE_API_KEY

# Prospects table (name or tbl… id)
PROSPECTS_TABLE_NAME=Prospects
# PROSPECTS_TABLE_ID=tblXXXXXXXXXXXXXX

# Exact field name for the situation column (lookup / multi-select supported)
# PROSPECT_SITUATION_FIELD=Prospect Situation

# --- KPIS write behaviour ---
# prompt (default if unset) = after printing stats, ask y/n to PATCH KPIS
# true        = always update KPIS after stats (no question)
# false       = never update KPIS (no question)
UPDATE_KPIS=prompt

KPIS_TABLE_NAME=KPIS
# KPIS_TABLE_ID=tblXXXXXXXXXXXXXX
# KPIS row must have number fields: Serious, Admitted, Lost, Last_chance, Engaged, Potential, Completed

# If set: PATCH this row with the counts. If unset: POST a new row each time you confirm/write.
# KPI_RECORD_ID=recXXXXXXXXXXXXXX
