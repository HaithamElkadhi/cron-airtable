# --- Airtable API ---
# Base id, table names, and the situation field name are hardcoded defaults in
# main.py (DEFAULT_BASE_ID / DEFAULT_PROSPECTS_TABLE / DEFAULT_KPIS_TABLE /
# DEFAULT_SITUATION_FIELD). Only the token is required here.

# Create at: https://airtable.com/create/tokens (Airtable calls this a
# "Personal Access Token" but it's your API key for this script).
# Scopes: data.records:read always; add data.records:write to update KPIS.
# Access must include this base's Prospects AND KPIS tables.
AIRTABLE_API_KEY=patXXXXXXXXXXXXXXXX

# --- KPIS write behaviour ---
# prompt (default if unset) = after printing stats, ask y/n to write KPIS
# true        = always update KPIS after stats (no question)
# false       = never update KPIS (no question)
UPDATE_KPIS=prompt

# KPIS row must have number fields: Lost, Lead, Prospect, Candidate, Student, Total_Prospect

# If set: PATCH this row with the counts. If unset: POST a new row each time you confirm/write.
# KPI_RECORD_ID=recXXXXXXXXXXXXXX

# --- Optional overrides (rarely needed; defaults live in main.py) ---
# AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
# AIRTABLE_BASE_URL=https://airtable.com/appXXXXXXXXXXXXXX/
# PROSPECTS_TABLE_NAME=Prospects
# KPIS_TABLE_NAME=KPIS
# PROSPECT_SITUATION_FIELD=Prospect Situation
